# Format:
#GitName=Username
#GitEmail=Email
#
#KeyIs=[0\1\2]
#GitGPGKeyId=SomeGPGKeyLongID
#
#SSHMode=[0/1/2]
#SSHKeysPaths=KeysPaths
#SSHKeyType=KeyType
#SSHKeyComment=CommentForNewKey
#SSHAddToAgent=[0/1]
#
#LoginGitHub=[0/1]
#LoginGitLab=[0/1]
#LoginBitbucket=[0/1]



# Example:
#GitName=User1234
#GitEmail=User.email@example.email
#
#KeyIs=1
#GitGPGKeyID=Text1234567890Text
#
#SSHMode=2
#SSHKeysPaths=~/.ssh/id_ed25519 ~/.ssh/id1_ed25519
#SSHKeyType=ed25519
#SSHKeyComment=SSH Key
#SSHAddToAgent=1
#
#LoginGitHub=1
#LoginGitLab=1
#LoginBitbucket=0



# Information:

# Use Email which is connected with GPG key to make GPG key work.
# Value of the variable 'KeyIs' should be either 0, 1, or 2.
# 0 does nothing to Git GPG key.
# 1 sets Git GPG key to which is in "Git-Login_Info.conf".
# 2 disables Git GPG key.

# Value of the variable 'SSHMode' should be either 0, 1, or 2.
# 0 skips SSH setup.
# 1 uses existing key(s) at 'SSHKeysPaths'.
# 2 creates a new SSH key at 'SSHKeysPaths'.

# Value of the variables 'LoginGitHub', 'LoginGitLab', and 'LoginBitBucket' should be either 0 or 1.
# 0 skips login.
# 1 does login.



# To make it work:
# 1. Create or rename this file with the name "Git-Login_Info.conf" in "Configs" directory.
# 2. Add there options following the format and example written up there.
# 3. Run "Git-Login.sh".
